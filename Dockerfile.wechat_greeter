# wechat_greeter Docker image (REQ-050 / REQ-051)
# A 阶段: 1 image 含 API + worker (docker-compose.wechat_greeter.yml 启动 2 容器共享 image)
# B/C 阶段: FAISS 索引 COPY 已预留位 (data/wechat_faq/), 索引缺失时 fail-fast
#
# 模式: 仿 apps/group_agent_api/Dockerfile
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH="/app/libs/deepagents:/app/libs/wechat_greeter"

# Create non-root user appuser (UID 1000, GID 1000)
RUN groupadd -r appuser -g 1000 2>/dev/null || true && \
    useradd -r -g appuser -u 1000 -d /home/appuser -s /bin/bash appuser 2>/dev/null || true
RUN mkdir -p /home/appuser && \
    mkdir -p /home/appuser/.deepagents && \
    mkdir -p /app/data/wechat_faq && \
    chown -R appuser:appuser /app /home/appuser

# Install requirements
COPY apps/wechat_greeter_api/requirements.txt /app/apps/wechat_greeter_api/requirements.txt 2>/dev/null || \
    echo "fastapi>=0.110\nuvicorn>=0.27\ncelery>=5.3.0\nredis>=5.0\nhttpx>=0.27\njinja2>=3.1\npydantic>=2.0" > /app/apps/wechat_greeter_api/requirements.txt

RUN pip install --no-cache-dir \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    -r /app/apps/wechat_greeter_api/requirements.txt

# Copy deepagents library
COPY libs/deepagents /app/libs/deepagents
# Copy wechat_greeter shared lib (跨进程复用)
COPY libs/wechat_greeter /app/libs/wechat_greeter

# Copy application code
COPY apps/wechat_greeter_api /app/apps/wechat_greeter_api
COPY apps/wechat_greeter_worker /app/apps/wechat_greeter_worker

# REQ-051 B/C 阶段: COPY FAISS 索引 (缺失时 fail-fast 由容器启动脚本校验)
# 注: A 阶段构建时 data/wechat_faq/ 目录可能尚无 .faiss 文件, 启动时 worker 校验后选择 fail-fast 或 fallback
COPY data/wechat_faq/ /app/data/wechat_faq/

# Re-fix ownership after COPY
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER 1000:1000

# Expose API port (worker 容器不暴露, 内部 celery 协议)
EXPOSE 8005

# Healthcheck: liveness only (REQ-065 P1-1/1-3).
# /healthz always 200 while the process is alive.
# Orchestrators with readiness support (K8s) should additionally probe GET /ready
# to gate traffic; Docker HEALTHCHECK alone cannot do traffic management.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD python -c "import http.client; conn = http.client.HTTPConnection('localhost', 8005); conn.request('GET', '/healthz'); r = conn.getresponse(); exit(0 if r.status == 200 else 1)" || exit 1

# Default entrypoint: API 容器. Worker 容器在 docker-compose.wechat_greeter.yml 覆盖 command.
CMD ["python", "-m", "uvicorn", "apps.wechat_greeter_api.main:app", "--host", "0.0.0.0", "--port", "8005", "--workers", "1", "--loop", "asyncio", "--http", "h11"]
