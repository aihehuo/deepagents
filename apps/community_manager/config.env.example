# No actual key, staff roster or customer information belongs in this file.
COMMUNITY_MANAGER_SECRET=
COMMUNITY_MANAGER_AGENT_KEY=
COMMUNITY_MANAGER_OPERATIONS_URL=
COMMUNITY_MANAGER_REDIS_URL=redis://redis:6379/6
COMMUNITY_MANAGER_MODEL=
COMMUNITY_MANAGER_MODEL_API_KEY=
COMMUNITY_MANAGER_MODEL_BASE_URL=

# Independent per-user synthesis budget; can use the same provider, explicit configuration required.
COMMUNITY_CUSTOMER_MODEL=
COMMUNITY_CUSTOMER_MODEL_API_KEY=
COMMUNITY_CUSTOMER_MODEL_BASE_URL=

# Required primary for BOTH background agents. Reuse the existing Deep Token Plan
# credential through the private env file; never paste it into source or logs.
COMMUNITY_LLM_PRIMARY_API_KEY=
COMMUNITY_LLM_PRIMARY_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
COMMUNITY_LLM_PRIMARY_MODEL=auto
# Existing COMMUNITY_MANAGER_MODEL* and COMMUNITY_CUSTOMER_MODEL* remain standby.
