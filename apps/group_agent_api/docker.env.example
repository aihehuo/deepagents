# Group Agent API Environment Configuration Example

# Runtime Environment (production / development / test)
GROUP_AGENT_ENV=production

# Integration Mode (http / stub)
GROUP_AGENT_INTEGRATION=http

# Principal Verification Security
GROUP_AGENT_REQUIRE_TRUSTED_PRINCIPAL=1
GROUP_AGENT_PRINCIPAL_HMAC_SECRET=<server-side-secret>
GROUP_AGENT_PRINCIPAL_MAX_SKEW_S=300

# Persistent Data Storage Directory
GROUP_AGENT_RUNTIME_DIR=/home/appuser/.deepagents/group_agent_api

# Member reads: public_skills (default) or legacy.
# Install selected packages into $GROUP_AGENT_RUNTIME_DIR/skills/aihehuo first.
# Public mode removes search_candidates; profile writes remain independent.
GROUP_AGENT_READ_MODE=public_skills

# Member writes: legacy (default), skillpack, or disabled.
# Install save-ai-user-profile into runtime/skills/aihehuo_write before skillpack.
# Only trusted sessions with write permission expose the installed write skill.
GROUP_AGENT_WRITE_MODE=legacy

# Optional stateless public entry: POST /chat/anonymous (no signed identity).
# Requires installed public read packages in runtime/skills/aihehuo.
GROUP_AGENT_ANONYMOUS_ENABLED=0
GROUP_AGENT_ANONYMOUS_MAX_ACTIVE=2
GROUP_AGENT_ANONYMOUS_MAX_QUERIES=3
GROUP_AGENT_ANONYMOUS_TIMEOUT_S=45

# Microservice Endpoints (Internal Docker Network)
# Use your own internal service hostnames; the values below are non-routable placeholders.
GROUP_AGENT_NEW_API_BASE=http://new-api.example.invalid:3000
GROUP_AGENT_MICRO_BASE=http://micro-web.example.invalid:3000
# Must match Micro ENV GROUP_AGENT_SERVICE_SECRET (ops_summary / ops_profiles).
GROUP_AGENT_SERVICE_SECRET=<shared-with-aihehuomicro>
# Profile upserts use GROUP_AGENT_CALLBACK_HMAC_SECRET and are accepted only
# when bound to an existing Micro-owned GroupAgentRun.
# User JWT for new_api (Authorization Bearer) — not an LLM key
GROUP_AGENT_NEW_API_TOKEN=<new-api-user-jwt>

# Callback & Async Task Settings (REQ-009)
GROUP_AGENT_CALLBACK_ALLOWED_BASE_URLS=http://micro-web.example.invalid:3000/group_agent_callbacks
GROUP_AGENT_CALLBACK_HMAC_SECRET=<directional-server-secret>
GROUP_AGENT_CALLBACK_TIMEOUT_S=10
GROUP_AGENT_CALLBACK_MAX_RETRIES=3
GROUP_AGENT_ASYNC_MAX_ACTIVE=10
GROUP_AGENT_ASYNC_RUN_TIMEOUT_S=120

# REQ-032 Durable Queue (default OFF — legacy process-local async)
# GROUP_AGENT_DURABLE_QUEUE_ENABLED=0
# When enabling locally, use an isolated Redis DB and test payload keys only:
# GROUP_AGENT_DURABLE_QUEUE_ENABLED=1
# GROUP_AGENT_REDIS_URL=redis://127.0.0.1:6379/15
# GROUP_AGENT_REDIS_PREFIX=ga:exec:v1
# GROUP_AGENT_CELERY_QUEUE=group_agent.runs
# GROUP_AGENT_DLQ_QUEUE=group_agent.dlq
# GROUP_AGENT_QUEUE_PAYLOAD_KEYS=v1:<32-byte-key-base64>
# GROUP_AGENT_QUEUE_PAYLOAD_CURRENT_VERSION=v1
# GROUP_AGENT_LEASE_TTL_S=30
# GROUP_AGENT_HEARTBEAT_INTERVAL_S=10
# GROUP_AGENT_VISIBILITY_TIMEOUT_S=240
# GROUP_AGENT_TASK_SOFT_LIMIT_S=150
# GROUP_AGENT_TASK_HARD_LIMIT_S=180
# GROUP_AGENT_MAX_ATTEMPTS=5
# GROUP_AGENT_RETRY_BASE_S=2
# GROUP_AGENT_RETRY_MAX_S=120
# GROUP_AGENT_QUEUE_MAX_DEPTH=500
# GROUP_AGENT_MAX_RUNNING=20
# GROUP_AGENT_PROVIDER_MAX_RUNNING=10
# GROUP_AGENT_USER_MAX_QUEUED=5
# GROUP_AGENT_GROUP_MAX_QUEUED=50

# LLM Model Configuration (Read by model_builder.py)
# Provider keys: use DASHSCOPE_API_KEY (qwen) or DEEPSEEK_API_KEY.
GROUP_AGENT_PROVIDER=qwen
GROUP_AGENT_MODEL=qwen-plus
GROUP_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=<your-dashscope-api-key>
DEEPSEEK_API_KEY=<your-deepseek-api-key>

# Generation parameters (optional)
GROUP_AGENT_MAX_TOKENS=2000
GROUP_AGENT_TIMEOUT_S=60
GROUP_AGENT_MAX_RETRIES=2
# Cafe Host has a tighter per-call budget because the durable worker owns run retries.
GROUP_AGENT_CAFE_MODEL_TIMEOUT_S=25
GROUP_AGENT_CAFE_REVIEW_TIMEOUT_S=20
# Optional observer only. It never delays, changes, or rejects a Cafe Host reply.
GROUP_AGENT_CAFE_SHADOW_REVIEW_ENABLED=0
GROUP_AGENT_CAFE_SHADOW_REVIEW_SAMPLE_RATE=0.05
GROUP_AGENT_CAFE_SHADOW_REVIEW_MAX_INFLIGHT=2
GROUP_AGENT_TEMPERATURE=0.3
GROUP_AGENT_MAX_INPUT_TOKENS=32000
