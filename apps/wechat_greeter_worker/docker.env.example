# WeChat Greeter worker environment configuration example (UC-35)
# Copy this file to .docker.env and fill the secrets before starting the app.
# .docker.env is intentionally gitignored and must never be committed.

# Safe local defaults. Production/grayscale must use deepseek and must set
# WECHAT_GREETER_DRY_RUN=false only when callback delivery is intentionally enabled.
WECHAT_GREETER_MODEL_MODE=stub
WECHAT_GREETER_DRY_RUN=true
WECHAT_GREETER_LLM_MODEL=deepseek-chat
WECHAT_GREETER_LLM_BASE_URL=https://api.deepseek.com
WECHAT_GREETER_LLM_TEMPERATURE=0.3
WECHAT_GREETER_LLM_MAX_TOKENS=512
DEEPSEEK_API_KEY=
# Optional compatibility fallback when DEEPSEEK_API_KEY is not used.
OPENAI_API_KEY=

# Must match SIMPLE_HMAC_SHARED_SECRET in new_api.
HMAC_SECRET_NEW_API=
# Must match MICRO_HMAC_SECRET in aihehuomicro.
HMAC_SECRET_AIHEHUOMICRO=
WECHAT_GREETER_HMAC_TIMESTAMP_SKEW_S=300

# Local Docker Desktop defaults. Replace with production-internal endpoints
# in the private production .docker.env files.
DEEPAGENTS_WECHAT_GREETER_CALLBACK_URL=http://host.docker.internal:3000/wechat_greeter_callbacks
HOST_AIHEHUOMICRO=http://host.docker.internal:3001
CELERY_BROKER_URL=redis://host.docker.internal:6379/0

WECHAT_GREETER_TRUNCATE_LIMIT=200
WECHAT_GREETER_DEAD_LETTER_AFTER_S=86400
